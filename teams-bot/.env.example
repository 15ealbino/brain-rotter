# ---------------------------------------------------------------------------
# Brain Rotter Teams recording bot - example environment
#
# Copy to .env (gitignored) or, better, set these as real environment variables
# on the host / in your service definition. NOTHING here belongs in appsettings.json
# or in git.
#
# .NET binds nested configuration with a double underscore:
#   Bot__AppSecret  ->  Bot:AppSecret
#
# For local development prefer user-secrets over a .env file - the values then live
# outside the repo entirely:
#   cd src/BrainRotter.TeamsBot
#   dotnet user-secrets set Bot:AppSecret "..."
# ---------------------------------------------------------------------------

# --- Identity -------------------------------------------------------------
# From scripts/Register-BotApp.ps1.
Bot__AppId=00000000-0000-0000-0000-000000000000
Bot__AppSecret=CHANGE-ME
Bot__TenantId=00000000-0000-0000-0000-000000000000

# Set false only if you registered the Entra app as multi-tenant. Controls which
# authority the Bot Connector token is requested from.
Bot__SingleTenantBot=true

# --- Network --------------------------------------------------------------
# Public HTTPS URL Graph posts call notifications to. Must be a real DNS name with a
# publicly trusted certificate. This is the SIGNALLING endpoint - a tunnel (ngrok,
# dev tunnels) can front this one.
Bot__BotBaseUrl=https://bot.example.com

# Public DNS name that resolves to THIS instance's instance-level public IP, used for
# the MEDIA leg. Usually the same host. A tunnel CANNOT carry this - see the README.
Bot__MediaServiceFqdn=bot.example.com

# Thumbprint (no spaces) of the TLS certificate in LocalMachine\My that the media
# platform presents for MTLS. Must chain to a publicly trusted root.
Bot__CertificateThumbprint=CHANGE-ME

# The media TCP port. InstancePublicPort must be reachable from the internet;
# InstanceInternalPort is what the process binds inside the VM. Behind a load balancer
# NAT rule these differ; on a plain VM with a public IP they are the same.
Bot__MediaInstanceInternalPort=8445
Bot__MediaInstancePublicPort=8445

# Graph calling endpoint. Change only for sovereign clouds (GCC High, DoD).
Bot__PlaceCallEndpointUrl=https://graph.microsoft.com/v1.0

# Bot Framework Connector base URL, used for the meeting-chat announcement.
# Global Teams: https://smba.trafficmanager.net/teams/
Bot__BotConnectorServiceUrl=https://smba.trafficmanager.net/teams/

# --- Behaviour ------------------------------------------------------------
Bot__DisplayName=Brain Rotter Recorder

# Ask for per-participant audio in addition to the mix, for speaker attribution.
Bot__ReceiveUnmixedAudio=true

# Post to the meeting chat on start/stop. This is IN ADDITION to Teams' own recording
# banner, which is driven by updateRecordingStatus and cannot be turned off here.
Bot__AnnounceInMeetingChat=true

# Leave if nobody admits the bot from the lobby within this many seconds.
Bot__LobbyTimeoutSeconds=300

# Hard cap on one recording, in minutes. 0 disables. 480 min ~= 920 MB of 16 kHz WAV.
Bot__MaxCallDurationMinutes=480

# DEVELOPMENT ONLY. Lets the service start when the Real-time Media Platform will not
# initialize (e.g. you are on Linux or macOS). /api/join then returns 503 and no meeting
# can be recorded. Never true in production.
Bot__AllowStartWithoutMediaPlatform=false

# --- Where recordings go --------------------------------------------------
# Explicit recordings root. Wins over everything. Set this when the bot runs somewhere
# other than the machine the desktop app is on - a file share, a synced folder, a
# staging directory you copy from.
#   Windows: BrainRotter__StorageRoot=D:\brain-rotter-recordings
#   Linux:   BrainRotter__StorageRoot=/srv/brain-rotter/recordings
BrainRotter__StorageRoot=

# Alternatively point at the desktop app's userData directory and the bot will resolve
# the root the same way the app does (settings.json storageRoot, else <userData>/recordings).
# Leave both blank to use the OS default for this machine.
BrainRotter__UserDataDir=

BrainRotter__AppName=brain-rotter
BrainRotter__WriteSpeakerAttribution=true
